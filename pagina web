        /* =========================
           EFECTOS
        ========================= */

        .efectos {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 25px;
        }

        .efecto {
            background: white;
            padding: 30px;
            border-radius: 15px;
            text-align: center;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
            border-top: 5px solid #00a8cc;
            transition: 0.3s;
        }

        .efecto:hover {
            transform: translateY(-8px);
        }

        .efecto span {
            font-size: 45px;
            display: block;
            margin-bottom: 15px;
        }

